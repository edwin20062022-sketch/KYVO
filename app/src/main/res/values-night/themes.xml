<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kyvo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kyvo_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/kyvo_splash_isotipo_inset</item>
        <item name="postSplashScreenTheme">@style/Theme.Kyvo</item>
    </style>

    <style name="Theme.Kyvo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
